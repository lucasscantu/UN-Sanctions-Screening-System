# =============================================================================
# UN Sanctions Screening System - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sanctions
DB_USERNAME=sanctions
DB_PASSWORD=sanctions

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Ollama AI Configuration
# -----------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# UN Sanctions XML Configuration
# -----------------------------------------------------------------------------
SANCTIONS_XML_URL=https://www.un.org/securitycouncil/content/un-sc-consolidated-list-xml
SANCTIONS_DOWNLOAD_TIMEOUT=300
SANCTIONS_SYNC_INTERVAL=24
SANCTIONS_MAX_RECORDS=10000

# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
SEARCH_CANDIDATE_LIMIT=50
SEARCH_SIMILARITY_THRESHOLD=60
SEARCH_MIN_SCORE_FILTER=0
SEARCH_MAX_AI_CANDIDATES=10

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
JPA_SHOW_SQL=false

# -----------------------------------------------------------------------------
# Frontend Configuration (for development)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# =============================================================================
# Docker Compose Specific Configuration
# =============================================================================
# When using Docker Compose, use these service-specific configurations:

# For backend service:
# DB_URL=jdbc:postgresql://postgres:5432/sanctions
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # For Docker Desktop
# OLLAMA_BASE_URL=http://172.17.0.1:11434  # For Linux (host network)

# For frontend service:
# VITE_API_BASE_URL=http://backend:8080/api

# =============================================================================
# Production Configuration
# =============================================================================
# For production, set these additional variables:
# SPRING_PROFILES_ACTIVE=prod
# LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO
# JPA_SHOW_SQL=false
# OLLAMA_ENABLED=true
# SEARCH_CANDIDATE_LIMIT=100
